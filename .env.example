# Environment Configuration for Bomberman DOM Game

# Server Configuration
PORT=8080
NODE_ENV=development

# WebSocket Configuration
WS_PORT=8080
WS_HOST=localhost

# Game Configuration
MAX_PLAYERS_PER_ROOM=4
MIN_PLAYERS_TO_START=2
WAITING_TIMEOUT=20000
COUNTDOWN_DURATION=10000
GAME_DURATION=300000

# Performance Configuration
TARGET_FPS=60
PERFORMANCE_MONITOR_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_COLORS=true
LOG_TIMESTAMP=true

# Debug Configuration
DEBUG_MODE=false
SHOW_PERFORMANCE_MONITOR=false
LOG_NETWORK_MESSAGES=false

# Security Configuration (for production)
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Database Configuration (for future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bomberman
# DB_USER=bomberman
# DB_PASSWORD=password

# Redis Configuration (for future scaling)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Monitoring Configuration (for production)
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
# DATADOG_API_KEY=
